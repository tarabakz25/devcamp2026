# --- Slack (必須) ---
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# App-Level Token for Socket Mode (xapp-...、Socket Mode用)
SLACK_APP_TOKEN=

# --- Bot動作 ---
# true=投稿せずログだけ / false=実際に投稿
DRY_RUN=true
# dummy | xai | openai | openai-compatible
# 未設定なら XAI_API_KEY があれば xai、なければ dummy
LLM_PROVIDER=dummy

# --- SpaceXAI / xAI (LLM_PROVIDER=xai のとき。未設定の LLM_PROVIDER でもキーがあれば使う) ---
XAI_API_KEY=
XAI_MODEL=grok-4.6

# --- OpenAI (LLM_PROVIDER=openai のとき必須) ---
OPENAI_API_KEY=
# 使うモデル名
OPENAI_MODEL=gpt-4o-mini
# 介入判定専用。未設定なら OPENAI_MODEL / XAI_MODEL を使う
# JUDGE_MODEL=gpt-5.6-luna
# JUDGE_REASONING_EFFORT=none
# OpenAI互換プロキシを使うときだけ設定 (未設定なら本家API)
# OPENAI_BASE_URL=https://example.com/v1

# --- DB ---
# 未設定ならSQLite(:memory:)で動く。本番は例↓
# DATABASE_URL=postgresql://ai:ai@localhost:5432/aibot
DATABASE_URL=
# デモチャット用 Dashboard API は未設定なら data/local.db
# SQLITE_PATH=data/local.db

# --- Web (apps/web用) ---
# Python Dashboard APIのURL
DASHBOARD_URL=http://localhost:8000

# --- Better Auth & Google 認証 ---
# Better Auth のシークレットキー (openssl rand -hex 32 等で生成)
BETTER_AUTH_SECRET=
# Better Auth のベースURL (ローカル開発時は http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console で取得した OAuth クライアントID & シークレット
# ※ Google Cloud Console の承認済みのリダイレクト URI に以下を追加してください:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
