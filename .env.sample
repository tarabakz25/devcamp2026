# --- Slack (必須) ---
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# App-Level Token for Socket Mode (xapp-...、Socket Mode用)
SLACK_APP_TOKEN=

# --- Bot動作 ---
# true=投稿せずログだけ / false=実際に投稿
DRY_RUN=true
# dummy | xai | openai | openai-compatible
# 未設定なら XAI_API_KEY があれば xai、なければ dummy
LLM_PROVIDER=dummy

# --- SpaceXAI / xAI (LLM_PROVIDER=xai のとき。未設定の LLM_PROVIDER でもキーがあれば使う) ---
XAI_API_KEY=
XAI_MODEL=grok-4.6

# --- OpenAI (LLM_PROVIDER=openai のとき必須) ---
OPENAI_API_KEY=
# 使うモデル名
OPENAI_MODEL=gpt-4o-mini
# 介入判定専用。未設定なら OPENAI_MODEL / XAI_MODEL を使う
# JUDGE_MODEL=gpt-5.6-luna
# JUDGE_REASONING_EFFORT=none
# OpenAI互換プロキシを使うときだけ設定 (未設定なら本家API)
# OPENAI_BASE_URL=https://example.com/v1

# --- DB ---
# 未設定ならSQLite(:memory:)で動く。本番は例↓
# DATABASE_URL=postgresql://ai:ai@localhost:5432/aibot
DATABASE_URL=
# デモチャット用 Dashboard API は未設定なら data/local.db
# SQLITE_PATH=data/local.db

# --- Web (apps/web用) ---
# Cloudflare移行後はこちらを優先 (roomi-worker のURL)。未設定なら下の
# Python Dashboard API (DASHBOARD_URL / localhost:8000) にフォールバック
# WORKER_URL=https://roomi-worker.<account>.workers.dev
# Python Dashboard APIのURL (ローカル開発用)
DASHBOARD_URL=http://localhost:8000

# --- Worker (apps/worker用 / wrangler secret 推奨) ---
# wrangler d1 create roomi → 出たIDを apps/worker/wrangler.jsonc に設定
# 本番シークレットは `wrangler secret put XAI_API_KEY` 等で登録
# SLACK_SIGNING_SECRET=   # /api/slack/events の署名検証用
# SLACK_BOT_TOKEN=        # chat.postMessage 返信用 (上と共通)
# AGREEMENT_API_TOKEN=    # Worker/Web間で共有。実Slackのthread APIに必須
# AGREEMENT_AUTO_ACTIONS=false
# AGREEMENT_AUTO_ACTION_MIN_CONFIDENCE=0.8
# AGREEMENT_APPROVER_USER_IDS=U0123ABC,U0456DEF

# --- Better Auth & Google 認証 ---
# Better Auth のシークレットキー (openssl rand -hex 32 等で生成)
BETTER_AUTH_SECRET=
# Better Auth のベースURL (ローカル開発時は http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console で取得した OAuth クライアントID & シークレット
# ※ Google Cloud Console の承認済みのリダイレクト URI に以下を追加してください:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 本番Control Centerで許可するGoogleアカウントとSlack thread ID
ROOMI_ALLOWED_USER_EMAILS=
ROOMI_ALLOWED_THREAD_IDS=
# デモthread IDをWorker既定値から変える場合
NEXT_PUBLIC_DEMO_THREAD_ID=demo-live
# 全thread横断の介入監査APIを公開する場合だけtrue
ROOMI_ALLOW_AUDIT=false
