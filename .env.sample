# --- Slack (必須) ---
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# App-Level Token for Socket Mode (xapp-...、Socket Mode用)
SLACK_APP_TOKEN=

# --- Bot動作 ---
# true=投稿せずログだけ / false=実際に投稿
DRY_RUN=true
# dummy | openai
LLM_PROVIDER=dummy

# --- OpenAI (LLM_PROVIDER=openai のとき必須) ---
OPENAI_API_KEY=
# 使うモデル名
OPENAI_MODEL=gpt-4o-mini
# OpenAI互換プロキシを使うときだけ設定 (未設定なら本家API)
# OPENAI_BASE_URL=https://example.com/v1

# --- DB ---
# 未設定ならSQLite(:memory:)で動く。本番は例↓
# DATABASE_URL=postgresql://ai:ai@localhost:5432/aibot
DATABASE_URL=

# --- Web (apps/web用) ---
# Python Dashboard APIのURL
DASHBOARD_URL=http://localhost:8000
